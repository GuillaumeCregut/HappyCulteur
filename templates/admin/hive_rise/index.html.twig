{% extends 'base.html.twig' %}

{% block title %}Gestion des hausses{% endblock %}
{% block stylesheets %}
	<link rel="stylesheet" href="{{asset('styles/default/admin/rise.css')}}">
{% endblock %}
{% block body %}
    <h1 class="title">Gestion des hausses</h1>
<p class="admin-rise-hive-btn-container"><a href="{{ path('app_admin_hive_rise_new') }}" class="form-button">Ajouter un modèle de hausse</a><p>
    <table class="admin-rise-hive-table">
        <thead>
            <tr class= "admin-rise-hive-row">
                <th colspan ="2" class="admin-rise-hive-cell">Action</th>
                <th class="admin-rise-hive-cell">Nom</th>
            </tr>
        </thead>
        <tbody>
        {% for hive_rise in hive_rises %}
            <tr class= "admin-rise-hive-row">
                <td class="admin-rise-hive-cell">{{ include('admin/hive_rise/_delete_form.html.twig') }}</td>
                <td class="admin-rise-hive-cell">
                    <a href="{{ path('app_admin_hive_rise_edit', {'id': hive_rise.id}) }}" class="form-button">Modifier</a>
                </td class="admin-rise-hive-cell">
                <td class="admin-rise-hive-cell">{{ hive_rise.name }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3" class="admin-rise-hive-cell-empty">Aucune information</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <p class="admin-rise-hive-btn-container"><a href="{{ path('app_admin_index') }}" class= "form-button">Retour à l'accueil admin</a></p>
{% endblock %}
