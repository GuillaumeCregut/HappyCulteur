<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>
			{% block title %}Gestion rucher
			{% endblock %}
		</title>
		<link rel="stylesheet" href="{{asset('styles/default/global.css')}}">
		<link rel="icon" type="image/x-icon" href="{{ asset('pictures/favicon.png') }}"> {% block stylesheets %}{% endblock %}

		{% block javascripts %}
			{% block importmap %}
				{{ importmap('app') }}
			{% endblock %}
		{% endblock %}
	</head>
	<body>
		{% block body %}{% endblock %}
	</body>
	<div class="footer">
		<hr>
		<p>Gestion rucher Version
			{{version}}</p>
		<p>(c)2017 - 2026 Editiel 98</p>
	</div>
</html>
