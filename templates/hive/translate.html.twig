{% extends 'base.html.twig' %}
{% block stylesheets %}
	<link rel="stylesheet" href="{{asset('styles/default/hive.css')}}">
{% endblock %}
{% block title %}Transférer la ruche{% endblock %}
{% block body %}
<h1 class="title">Déplacer la ruche</h1>
<p class="hive-form-translate-line">Nom de la ruche : {{ hive.name }}</p>
<p class="hive-form-translate-line">Rucher actuel : {{ hive.apiary.name }}</p>
{{ form_start(form) }}
        {{ form_errors(form) }}
        {{ form_row(form.apiaryList,  {
                    row_attr: {
                        class: 'hive-form-translate-row'
                    },
                    label: "Choisir le nouveau rucher : ",
                    attr : {
                        class: 'hive-form-translate-input'
                    }
            })
        }}
        <button class="form-button">re affecter</button>
        {{ form_end(form) }}
<p class="hive-btn-container"><a href="{{ path('app_apiary_index', {id: hive.apiary.id}) }}" class= "form-button">Retour au rucher</a></p>
{% endblock %}