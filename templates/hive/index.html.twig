{% extends 'base.html.twig' %}
{% block stylesheets %}
	<link rel="stylesheet" href="{{asset('styles/default/hive.css')}}">
{% endblock %}
{% block title %}Gestion de la ruche{% endblock %}

{% block body %}
<h1 class="title">Gestion de la ruche</h1>
<p class="hive-home-line">Rucher : {{hive.apiary.name ?? 'stock' }}</p>
<p class="hive-home-line">Nom : {{hive.name}}</p>
<p class="hive-home-line">Numéro : {{hive.identification}}</p>
<p class="hive-home-line">Type de ruche : {{hive.kind.name}}</p>
<p class="hive-home-line">Etat : 
<img src="{{ asset('uploads/' ~ hive.kind.picture ~ hive.state.label ~ '.png') }}" alt="icon {{ hive.name }}" class="hive-home-picture">
</p>

<section class="hive-home-container">
	<div class="hive-home-detail-container">
		<p class="hive-home-item">Informations</p>
		<ul class="hive-home-detail-list">
			<li>
				<a href="{{ path('app_swarm_index', {id: hive.id}) }}">
					<div class="hive-home-card">
						<img src="{{ asset( hive.swarm 
						? 'pictures/options/swarm.png'
						: 'pictures/options/noswarm.png') }}" alt="icone essaim" class="hive-home-card-picture">
						<p class="hive-home-card-title">Essaim</p>
					</div>
				</a>
			</li>
			<li>
				<a href="{{ path('app_hive_infos', {id: hive.id}) }}">
					<div class="hive-home-card">
						<img src="{{ asset('pictures/options/information.png') }}" alt="informations" class="hive-home-card-picture">
						<p class="hive-home-card-title">Informations</p>
					</div>
				</a>
			</li>
			<li>
				<a href="{{ path('app_visit_add', {id: hive.id}) }}">
					<div class="hive-home-card">
						<img src="{{ asset('pictures/options/visite.png') }}" alt="Visites" class="hive-home-card-picture">
						<p class="hive-home-card-title">Visite</p>
					</div>
				</a>
			</li>
			<li>
				<a href="{{ path('app_harvest_add', {id: hive.id}) }}">
					<div class="hive-home-card">
						<img src="{{ asset('pictures/admin/honey.png') }}" alt="Recoltes" class="hive-home-card-picture">
						<p class="hive-home-card-title">Récoltes</p>
					</div>
				</a>
			</li>
			<li>
				<a href="{{ path('app_stats_index', {id: hive.id}) }}">
					<div class="hive-home-card">
						<img src="{{ asset('pictures/options/stats.png') }}" alt="Statistiques" class="hive-home-card-picture">
						<p class="hive-home-card-title">Stats</p>
					</div>
				</a>
			</li>
			{% if hive.apiary is not null %}
			<li>
				<a href="{{ path('app_hive_carto', {id: hive.id}) }}">
					<div class="hive-home-card">
						<img src="{{ asset('pictures/apiaries/carto.png') }}" alt="cartographie" class="hive-home-card-picture">
						<p class="hive-home-card-title">Cartographie</p>
					</div>
				</a>
			</li>
			<li>
				<a href="{{ path('app_datalogger_hive',{id: hive.id}) }}">
					<div class="hive-home-card">
						<img src="{{ asset('pictures/options/sdcard.png') }}" alt="Datalogger" class="hive-home-card-picture">
						<p class="hive-home-card-title">Datalogger</p>
					</div>
				</a>
			</li>
			{% endif %}
			<li>
				<a href="{{ path('app_archive_hive',{id: hive.id}) }}">
					<div class="hive-home-card">
						<img src="{{ asset('pictures/options/archive.png') }}" alt="aide" class="hive-home-card-picture">
						<p class="hive-home-card-title">Archives</p>
					</div>
				</a>
			</li>
			<li>
				<a href="{{ path('app_help_hive') }}" target="_blank">
					<div class="hive-home-card">
						<img src="{{ asset('pictures/options/help.png') }}" alt="aide" class="hive-home-card-picture">
						<p class="hive-home-card-title">Aide</p>
					</div>
				</a>
			</li>
		</ul>
	</div>
</section>
{% if hive.apiary is null %}
<p class="hive-btn-container"><a href="{{ path('app_stock_home') }}" class= "form-button">Retour au stock</a></p>
{% else %}	
<p class="hive-btn-container"><a href="{{ path('app_apiary_index', {id: hive.apiary.id}) }}" class= "form-button">Retour au rucher</a></p>
{% endif %}
{% endblock %}
