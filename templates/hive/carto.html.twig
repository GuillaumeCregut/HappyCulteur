{% extends 'base.html.twig' %}
{% block stylesheets %}
	<link rel="stylesheet" href="{{asset('styles/default/hive.css')}}">
	<link rel="stylesheet" href="{{asset('styles/default/hive_carto.css')}}">
{% endblock %}
{% block title %}Ajout d'une ruche{% endblock %}

{% block body %}
<h1 class="title">Cartographie ruche</h1>
<p class="hive-carto-line">Cartographie du rucher : "{{ hive.apiary.name }}"</p>
<p class="hive-carto-line">Numéro du rucher : "{{ hive.apiary.identification }}"</p>
<p class="hive-carto-line">Nom de la ruche : "{{ hive.name }}"</p>
<section class="hive-carto-container"
{{ stimulus_controller('hive-carto', {
x:hive.coordX, 
y: hive.coordY, 
scale: hive.coordZ, 
name: hive.name, 
hivePicture: asset('/pictures/hives/ruche_carto.png'),
path: asset('/uploads/'~ hive.apiary.lastPicture), 
id: hive.id
}) }}>
    <div class="hive-carto-canvas-container">
    <canvas class="hive-carto-canvas"
     {{ stimulus_target('hive-carto', 'canvas') }}
     >Votre navigateur ne supporte pas le canvas</canvas>
    </div>
    <div class="hive-carto-command-container">
        <div class="hive-carto-button-grid">
            <div class="hive-carto-btn-container hive-carto-button-up-container">
                <button class="hive-carto-btn-up" {{ stimulus_action('hive-carto', 'moveUp') }}>Haut</button>
            </div>
            <div class="hive-carto-btn-container hive-carto-button-left-container">
                <button class="hive-carto-btn-left" {{ stimulus_action('hive-carto', 'moveLeft') }}>Gauche</button>
            </div>
            <div class="hive-carto-btn-container hive-carto-button-zoom-in-container">
                <button class="hive-carto-btn-zoom-in" {{ stimulus_action('hive-carto', 'zoomIn') }}>+</button>
            </div>
            <div class="hive-carto-btn-container hive-carto-button-zoom-out-container">
                <button class="hive-carto-btn-zoom-out" {{ stimulus_action('hive-carto', 'zoomOut') }}>-</button>
            </div>
            <div class="hive-carto-btn-container hive-carto-button-right-container">
                <button class="hive-carto-btn-right" {{ stimulus_action('hive-carto', 'moveRight') }}>Droit</button>
            </div>
            <div class="hive-carto-btn-container hive-carto-button-down-container">
                <button class="hive-carto-btn-down"{{ stimulus_action('hive-carto', 'moveDown') }}>Bas</button>
            </div>
        </div>
    </div>
</section>
<p class="hive-btn-container"><a href="{{ path('app_hive_index',  {id: hive.id}) }}" class= "form-button">Retour à la ruche</a></p>
{% endblock %}