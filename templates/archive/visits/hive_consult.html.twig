{% extends 'base.html.twig' %}
{% block stylesheets %}
	<link rel="stylesheet" href="{{asset('styles/default/archives/visit.css')}}">
	<link rel="stylesheet" href="{{asset('styles/default/archives/visit_hive.css')}}">
	<link rel="stylesheet" href="{{asset('styles/default/archives/global.css')}}">
{% endblock %}
{% block title %}Archives visites
{% endblock %}

{% block body %}
	<h1 class="title">Archives de la ruche</h1>
	<table class="archive-visit-table">
        <caption>Archives des visites</caption>
		<thead class="archive-visit-table-head">
			<tr>
				<th class="archive-visit-cell archive-visit-cell-head">Date</th>
				<th class="archive-visit-cell archive-visit-cell-head">Ruche</th>
				<th class="archive-visit-cell archive-visit-cell-head">Climat</th>
				<th class="archive-visit-cell archive-visit-cell-head">Maladie constatée</th>
				<th class="archive-visit-cell archive-visit-cell-head">Nourriture effectuée</th>
				<th class="archive-visit-cell archive-visit-cell-head">Travaux à faire</th>
				<th class="archive-visit-cell archive-visit-cell-head">Comportement</th>
				<th class="archive-visit-cell archive-visit-cell-head">Population</th>
				<th class="archive-visit-cell archive-visit-cell-head">Reine visible</th>
				<th class="archive-visit-cell archive-visit-cell-head">Température</th>
				<th class="archive-visit-cell archive-visit-cell-head">Hygrométrie</th>
				<th class="archive-visit-cell archive-visit-cell-head">Poids</th>
				<th class="archive-visit-cell archive-visit-cell-head">Notes</th>
			</tr>
		</thead>
		<tbody>
			{% for archive in archives %}
			    <tr>
                    <td class="archive-visit-cell" data-label="Date">{{ archive.date | date('d/m/Y')}}</td>
					<td class="archive-visit-cell" data-label="Ruche">{{ archive.hive }}</td>
					<td class="archive-visit-cell" data-label="Climat">{{ archive.weather }}</td>
					<td class="archive-visit-cell" data-label="Maladie">{{ archive.isDisease ? archive.disease : 'Auncune' }}</td>
					<td class="archive-visit-cell" data-label="Nourriture">{{ archive.isFeeded ? archive.feeding : 'Non' }}</td>
					<td class="archive-visit-cell archive-visit-cell-center" data-label=" Travaux">{{ archive.isWorkToDo ? 'Oui' : 'Non' }}</td>
					<td class="archive-visit-cell" data-label="Comportement">{{ archive.behaviour is null ? '-' : archive.behaviour }}</td>
					<td class="archive-visit-cell" data-label="Population">{{ archive.population is null ? '-' : archive.population }}</td>
					<td class="archive-visit-cell archive-visit-cell-center" data-label="Reine visible">{{ archive.isQueenVisible ? 'Oui' : 'Non' }}</td>
					<td class="archive-visit-cell archive-visit-cell-center" data-label="Température">{{ archive.temperature is null ? '-' : archive.temperature }} °C</td>
					<td class="archive-visit-cell archive-visit-cell-center" data-label="Hygrométrie">{{ archive.hygrometry is null ? '-' : archive.hygrometry }} %</td>
					<td class="archive-visit-cell archive-visit-cell-center" data-label="Poids">{{ archive.weight is null ? '-' : archive.weight}} kg</td>
					<td class="archive-visit-cell archive-visit-cell-notes" data-label="Notes">{{ archive.notes  is null ? '-' : archive.notes }}</td>
			    </tr>
            {% else %}
                <tr>
                    <td colspan="13">Aucune informations</td>
                </tr>    
				{% endfor %}
		</tbody>
	</table>
	<p>
		<a href="{{ path('app_hive_index', {id:hive.id}) }}" class="form-button">Retour à la ruche</a>
	</p>
{% endblock %}
