<section class="container">
	<div class="apiary-container">
		<p class="item">Ruchers</p>
		<ul class="apiaries">
		{% for apiary in apiaries%}
			<li>
				<a href="{{ path('app_apiary_index', {id: apiary.id}) }}">
					<div class="hivecard">
						<img src="{{ asset('pictures/apiaries/rucher' ~ (apiary.isActive ? '' : '_dead') ~ '.png') }}" alt="rucher1" class="apiary-picture">
						<p class="apiary-card-title">{{ apiary.name }}</p>
					</div>
				</a>
			</li>
			{% endfor %}
            <li>
				<a href="{{ path('app_apiary_add') }}">
					<div class="hivecard">
						<img src="{{ asset('pictures/apiaries/add_rucher.png') }}" alt="ajouter un rucher" class="apiary-picture">
						<p class="apiary-card-title">Ajouter un rucher</p>
					</div>
				</a>
			</li>
			<li>
				<a href="{{ path('app_stock_home') }}">
					<div class="hivecard">
						<img src="{{ asset('pictures/apiaries/stock.png') }}" alt="Stock" class="apiary-picture">
						<p class="apiary-card-title">Stock de ruches</p>
					</div>
				</a>
			</li>
		</ul>
	</div>
    <hr>
	<div class="other-container">
		<p class="item">Divers</p>
		<ul class="others">
			<li>
				<a href="{{ path('app_user_index') }}">
					<div class="item-card">
						<img src="{{ asset('pictures/options/information.png') }}" alt="informations" class="other-picture">
						<p class="other-card-title">Informations</p>
					</div>
				</a>
			</li>
            <li>
				<a href="{{ path('app_params') }}">
					<div class="item-card">
						<img src="{{ asset('pictures/options/parametre.png') }}" alt="paramètres" class="other-picture">
						<p class="other-card-title">Paramètres</p>
					</div>
				</a>
			</li>
            <li>
				<a href="{{ path('app_purchase_index') }}">
					<div class="item-card">
						<img src="{{ asset('pictures/options/achats.png') }}" alt="achats" class="other-picture">
						<p class="other-card-title">Achats</p>
					</div>
				</a>
			</li>
            <li>
				<a href="{{ path('app_stats_beekeeper_home')}}">
					<div class="item-card">
						<img src="{{ asset('pictures/options/stats.png') }}" alt="statistiques" class="other-picture">
						<p class="other-card-title">Statistiques</p>
					</div>
				</a>
			</li>
            <li>
				<a href="{{ path('app_help_index') }}">
					<div class="item-card">
						<img src="{{ asset('pictures/options/help.png') }}" alt="aide" class="other-picture">
						<p class="other-card-title">Aide</p>
					</div>
				</a>
			</li>
			{% if is_granted('ROLE_ADMIN') %}
			<li>
				<a href="{{ path('app_admin_index') }}">
					<div class="item-card">
						<img src="{{ asset('pictures/options/admin.png') }}" alt="admin" class="other-picture">
						<p class="other-card-title">Admin</p>
					</div>
				</a>
			</li>
			{% endif %}
		</ul>
	</div>
</section>
